{
  "name": "simple_dns_server",
  "version": "3.0.0",
  "main": "main.mjs",
  "type": "module",
  "scripts": {
    "start": "node main.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "test:unit": "node --test tests/source-state.test.mjs tests/local-isolation.test.mjs tests/cache-level.test.mjs",
    "test:integration": "node --test tests/repository.integration.test.mjs",
    "test:cache": "node --test tests/cache-level.test.mjs",
    "db:create": "node scripts/create-db.mjs",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all"
  },
  "author": "Mohammad V. Alaaei (MVA)",
  "license": "GPL-3.0-only",
  "description": "Custom DNS server that receives DNS requests and decides what to do with them",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dns2": "^3.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.2",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5"
  }
}
