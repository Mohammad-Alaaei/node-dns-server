NODE_ENV=development

# =============================================================================
# DNS server — INFRA / SECRETS (stay in .env only; never stored in settings DB)
# =============================================================================

# Bind address for the DNS socket (requires restart to change)
SERVER_IP=127.0.0.1
SERVER_PORT=53

# Upstream query port (infra)
DNS_PORT=53

# -----------------------------------------------------------------------------
# Operational defaults (also seeded into settings user_id=0 as config.system)
# After first seed / loadSystemSettings(), runtime reads config.system from DB
# merge — change live via PATCH /api/settings/system (superadmin).
# -----------------------------------------------------------------------------
PTR_HOSTNAME=localhost.com
DEBUG_PREFIX=_.

DNS_TTL=60
DNS_TIMEOUT=8000

# ALL | CUSTOM_ONLY | FILTERED_ONLY | NONE
CACHE_LEVEL=ALL
CACHE_EXPIRE_TIME=60
FLUSH_INTERVAL_MS=60000

# Space-separated/comma-separated IPs that mark answers as FILTERED
# (required for FILTERED_ONLY to store anything)
FILTER_IPS=10.10.34.35 10.10.34.34 10.10.34.36 2001:4188:2:600:10:10:34:35 2001:4188:2:600:10:10:34:36

# Extra: skip log queue only when these IPs appear (cache still follows CACHE_LEVEL)
IGNORE_IPS=10.10.34.35 10.10.34.34 10.10.34.36 2001:4188:2:600:10:10:34:35 2001:4188:2:600:10:10:34:36 50.7.5.83 50.7.87.5 50.7.87.4 0.0.0.0

# -----------------------------------------------------------------------------
# MySQL — shared server (ROOT only for bootstrap / create-db)
# -----------------------------------------------------------------------------
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=root_secret

# -----------------------------------------------------------------------------
# MySQL — app database (Sequelize + runtime) — NEVER in settings table
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dns_server
DB_USER=dns
DB_PASSWORD=secret

DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_LOGGING=false

# -----------------------------------------------------------------------------
# Logger
# -----------------------------------------------------------------------------
LOG_DIR="./logs"
LOG_FLUSH_INTERVAL=5000
LOG_MAX_BUFFER_SIZE=100
# Max single log file size in KB before rotation (10240 = 10 MB)
LOG_MAX_SIZE_KB=10240

# -----------------------------------------------------------------------------
# HTTP API — secrets / bind — NEVER in settings table
# -----------------------------------------------------------------------------
API_ENABLED=true
API_HOST=127.0.0.1
API_PORT=3000
API_JWT_SECRET=change-me-in-production
API_JWT_EXPIRES_IN=15m
API_REFRESH_EXPIRES_IN=7d

# CORS (browser frontend). Empty = no CORS headers (same-origin only).
# Comma-separated exact origins, or * for any origin.
# Example Vite/React: http://localhost:5173
API_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Send Access-Control-Allow-Credentials (needed if you use cookies). Default true.
API_CORS_CREDENTIALS=true
# Optional overrides:
# API_CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
# API_CORS_HEADERS=Content-Type,Authorization
# API_CORS_MAX_AGE=86400

# Optional persistent RSA PEMs for login password encryption (\n for newlines).
# API_RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# API_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Bootstrap superadmin (created when no non-system user exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# -----------------------------------------------------------------------------
# Optional UI defaults (config.ui — baseline for per-user settings JSON)
# -----------------------------------------------------------------------------
# UI_LANGUAGE=en
# UI_THEME=system
# UI_DARK_MODE=false