NODE_ENV=development

# -----------------------------------------------------------------------------
# DNS server
# -----------------------------------------------------------------------------
SERVER_IP=127.0.0.1
SERVER_PORT=53

PTR_HOSTNAME=localhost.com
DEBUG_PREFIX=_.

# Upstream DNS defaults
DNS_PORT=53
DNS_TTL=60
DNS_TIMEOUT=8000

# Cache + upstream-answer logging (same gate)
# ALL           → log + cache custom and default upstream answers
# CUSTOM_ONLY   → log + cache only custom upstream answers
# FILTERED_ONLY → log + cache only answers that contain a FILTER_IPS address
# NONE          → no upstream-answer logging, no caching (errors still log)
CACHE_LEVEL=ALL
CACHE_EXPIRE_TIME=60
FLUSH_INTERVAL_MS=60000

# Space-separated/comma-separated IPs that mark answers as FILTERED
# (required for FILTERED_ONLY to store anything)
FILTER_IPS=10.10.34.35 10.10.34.34 10.10.34.36 2001:4188:2:600:10:10:34:35 2001:4188:2:600:10:10:34:36

# Extra: skip log queue only when these IPs appear (cache still follows CACHE_LEVEL)
IGNORE_IPS=10.10.34.35 10.10.34.34 10.10.34.36 2001:4188:2:600:10:10:34:35 2001:4188:2:600:10:10:34:36 50.7.5.83 50.7.87.5 50.7.87.4 0.0.0.0


# -----------------------------------------------------------------------------
# MySQL — shared server (ROOT only for bootstrap / create-db)
# -----------------------------------------------------------------------------
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=root_secret

# -----------------------------------------------------------------------------
# MySQL — this app's database (Sequelize + runtime)
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dns_server
DB_USER=dns
DB_PASSWORD=secret

DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_LOGGING=false

# -----------------------------------------------------------------------------
# Logger
# -----------------------------------------------------------------------------
LOG_DIR="./logs"
LOG_FLUSH_INTERVAL=5000
LOG_MAX_BUFFER_SIZE=100

# -----------------------------------------------------------------------------
# HTTP API
# -----------------------------------------------------------------------------
API_ENABLED=true
API_HOST=127.0.0.1
API_PORT=3000
API_JWT_SECRET=change-me-in-production
API_JWT_EXPIRES_IN=5m

# Optional: persistent RSA PEMs for login password encryption (\\n for newlines).
# If omitted, a new key pair is generated on every process start.
# API_RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----"
# API_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"


# Bootstrap superadmin (created only when users table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me